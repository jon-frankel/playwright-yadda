<idea-plugin>
  <id>io.github.jonfrankel.playwright-yadda</id>
  <name>Playwright Yadda</name>
  <vendor url="https://github.com/jon-frankel/playwright-yadda">Jonathan Frankel</vendor>

  <description><![CDATA[
    <p>IDE support for <a href="https://github.com/jon-frankel/playwright-yadda">playwright-yadda</a>,
    which runs Gherkin features through Playwright with Yadda step libraries.</p>
    <p>WebStorm's Cucumber.js support already navigates from a <code>.feature</code> step to its definition.
    This plugin adds the other direction, and teaches both about <code>@Libraries</code>:</p>
    <ul>
      <li><b>Go to usages / Find Usages</b> on a step definition
        (<code>steps.given("…", fn)</code>) lists the feature steps that run it.</li>
      <li><b>Library-aware navigation:</b> when two libraries define the same step text, going to
        the definition from a feature step, and listing a definition's usages, only consider
        the libraries the scenario enables, and the "Ambiguous step reference" warning no
        longer fires for a step the scenario's libraries resolve to one definition.</li>
      <li><b>Library names:</b> Cmd+B on a name in <code>@Libraries=…</code> goes to the registry
        property that defines it, and from the property, Find Usages and rename reach every
        feature that uses the name.</li>
      <li><b>Yadda syntax:</b> <code>---</code> fenced blocks under a step (tables, JSON, CSV)
        parse cleanly instead of showing "Unexpected element", and tables align on reformat.
        A remark such as <code>--- json</code> injects that language into the block, and a
        <code>--- csv</code> block is checked for ragged rows.</li>
      <li><b>Yadda's own style:</b> steps with no <code>Given</code>/<code>When</code>/<code>Then</code>,
        <code>Where:</code> and <code>Examples:</code> rows without pipes (<code>qty | total</code>) read
        as tables that Reformat aligns, tags and dashed groups between rows, and keywords in any case.</li>
      <li><b>What Yadda would make of the file:</b> Yadda's own parser errors, on the line they are
        about, before the tests run; a warning for <code>Rule:</code>, whose scenarios playwright-yadda
        doesn't run; unused <code>[column]</code>s of an examples table; and step definitions that
        match the whole step, block included, with <code>[name]</code> filled in.</li>
      <li><b>Run from the gutter:</b> the run icon next to <code>Feature:</code> and
        <code>Scenario:</code> runs the tests through Playwright, narrowed to that feature or scenario.</li>
    </ul>
  ]]></description>

  <depends>com.intellij.modules.platform</depends>
  <depends>JavaScript</depends>
  <depends>gherkin</depends>
  <depends>cucumber-javascript</depends>

  <extensions defaultExtensionNs="com.intellij">
    <!-- *.yadda.feature: Gherkin as Yadda writes it, with dashed fences around multi-line steps. -->
    <fileType name="Yadda" implementationClass="io.github.jonfrankel.playwrightyadda.yadda.YaddaFileType"
              fieldName="INSTANCE" language="Yadda" patterns="*.yadda.feature"/>
    <lang.parserDefinition language="Yadda"
        implementationClass="io.github.jonfrankel.playwrightyadda.yadda.YaddaParserDefinition"/>
    <!-- Gherkin's colours over the Yadda lexer, so a row without pipes and a Where: are coloured as what they are. -->
    <lang.syntaxHighlighterFactory language="Yadda"
        implementationClass="io.github.jonfrankel.playwrightyadda.yadda.YaddaSyntaxHighlighterFactory"/>
    <!-- Gherkin's formatting, with the rows of an Examples table that start with a cell. -->
    <lang.formatter language="Yadda"
        implementationClass="io.github.jonfrankel.playwrightyadda.yadda.YaddaFormattingModelBuilder"/>
    <!-- A .feature file in a project that depends on playwright-yadda is parsed as Yadda too. -->
    <lang.substitutor language="Gherkin"
        implementationClass="io.github.jonfrankel.playwrightyadda.yadda.YaddaLanguageSubstitutor"/>
    <!-- A dashed block that names a language after its dashes (json, sql, and so on) is that language. -->
    <multiHostInjector implementation="io.github.jonfrankel.playwrightyadda.yadda.YaddaLanguageInjector"/>
    <!-- Gherkin's would close the block with quote marks and rewrite a fragment edit's fences into them. -->
    <enterHandlerDelegate implementation="io.github.jonfrankel.playwrightyadda.yadda.YaddaEnterHandler" order="first"/>
    <lang.elementManipulator forClass="org.jetbrains.plugins.cucumber.psi.GherkinPystring"
        implementationClass="io.github.jonfrankel.playwrightyadda.yadda.YaddaPystringManipulator" order="first"/>
    <!-- Gherkin's pads a row so a typed pipe lines up, but only in files of its own type. -->
    <typedHandler implementation="io.github.jonfrankel.playwrightyadda.yadda.YaddaTypedHandler"/>
    <localInspection language="Gherkin" shortName="YaddaCsvBlock" groupName="Playwright Yadda"
        displayName="Ragged CSV block" enabledByDefault="true" level="WARNING"
        implementationClass="io.github.jonfrankel.playwrightyadda.yadda.YaddaCsvBlockInspection"/>
    <localInspection language="Gherkin" shortName="YaddaParse" groupName="Playwright Yadda"
        displayName="Feature Yadda can't parse" enabledByDefault="true" level="ERROR"
        implementationClass="io.github.jonfrankel.playwrightyadda.yadda.YaddaParseInspection"/>
    <localInspection language="Gherkin" shortName="YaddaRule" groupName="Playwright Yadda"
        displayName="Rule whose scenarios are not run" enabledByDefault="true" level="WARNING"
        implementationClass="io.github.jonfrankel.playwrightyadda.yadda.YaddaRuleInspection"/>
    <localInspection language="Gherkin" shortName="YaddaUnusedColumn" groupName="Playwright Yadda"
        displayName="Unused examples column" enabledByDefault="true" level="WARNING"
        editorAttributes="NOT_USED_ELEMENT_ATTRIBUTES"
        implementationClass="io.github.jonfrankel.playwrightyadda.yadda.YaddaUnusedColumnInspection"/>
    <!-- Gherkin's unused-column, scenario-with-examples and outline-without-examples checks don't apply to Yadda. -->
    <lang.inspectionSuppressor language="Gherkin"
        implementationClass="io.github.jonfrankel.playwrightyadda.yadda.YaddaInspectionSuppressor"/>
    <!-- Makes a step-definition call a declaration, so Cmd+B on it shows its usages. -->
    <pom.declarationSearcher
        implementation="io.github.jonfrankel.playwrightyadda.steps.YaddaStepPomDeclarationSearcher"/>
    <!-- Finds the Gherkin steps that run a step definition. -->
    <referencesSearch
        implementation="io.github.jonfrankel.playwrightyadda.steps.YaddaStepReferencesSearch"/>
    <!-- ...and the names in @Libraries=… as references to the registry property that defines them. -->
    <referencesSearch
        implementation="io.github.jonfrankel.playwrightyadda.steps.YaddaLibraryNameReferencesSearch"/>
    <findUsagesHandlerFactory
        implementation="io.github.jonfrankel.playwrightyadda.steps.YaddaFindUsagesHandlerFactory"/>
    <!-- Narrows Cmd+B on a feature step to the definitions its scenario's @Libraries enable. -->
    <gotoDeclarationHandler
        implementation="io.github.jonfrankel.playwrightyadda.steps.YaddaStepGotoDeclarationHandler"/>
    <!-- Cmd+B on a name in @Libraries=… goes to the registry property that defines it. -->
    <gotoDeclarationHandler
        implementation="io.github.jonfrankel.playwrightyadda.steps.YaddaLibraryNameGotoDeclarationHandler"/>
    <!-- ...and silences "Ambiguous step reference" once that leaves a single definition. -->
    <lang.inspectionSuppressor language="Gherkin"
        implementationClass="io.github.jonfrankel.playwrightyadda.steps.YaddaAmbiguousStepSuppressor"/>
    <!-- The run icon next to Feature:/Scenario: runs the spec through Playwright, narrowed by a grep pattern. -->
    <runConfigurationProducer
        implementation="io.github.jonfrankel.playwrightyadda.run.YaddaFeatureRunConfigurationProducer"/>
    <elementDescriptionProvider
        implementation="io.github.jonfrankel.playwrightyadda.steps.YaddaStepDescriptionProvider"/>
  </extensions>
  <extensions defaultExtensionNs="org.jetbrains.plugins.cucumber.steps">
    <!-- What Yadda matches a step against: the whole step, fenced block included, with [name] filled in. -->
    <cucumberJvmExtensionPoint implementation="io.github.jonfrankel.playwrightyadda.yadda.YaddaCucumberExtension"/>
  </extensions>
</idea-plugin>
