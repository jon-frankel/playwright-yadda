{
  "name": "playwright-yadda",
  "version": "0.0.4",
  "description": "Dynamic step library loading for Playwright and Yadda BDD",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.mts",
          "default": "./dist/index.mjs"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "prepare": "lefthook install",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm run format && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "verdaccio:start": "docker compose up -d --wait",
    "verdaccio:stop": "docker compose down",
    "verdaccio:create-token": "echo NPM_TOKEN=$(node scripts/npm-authn/index.mjs create-token playwright-yadda password http://localhost:4873) >> .env",
    "verdaccio:sync": "node scripts/verdaccio-sync.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^24.15.0",
    "axios": "^1.13.5",
    "dotenv": "^18.0.8",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "rolldown": "^1.2.14",
    "tsdown": "^0.23.1",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  }
}
